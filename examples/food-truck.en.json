    {
      "id": "s-preorder",
      "number": 2,
      "title": "Place pre-order",
      "role": "a hungry guest",
      "want": "place my order in advance on my phone",
      "benefit": "I don’t have to queue",
      "notes": "Pre-orders only during opening hours, at least 10 minutes ahead.",
      "size": "M",
      "priority": "must",
      "epicId": "e-order",
      "status": "ready",
      "dependsOn": [
        "s-pay"
      ],
      "conversation": [
        {
          "id": "k1",
          "kind": "note",
          "author": "Lena (PO)",
          "text": "Guests should be able to pick a pick-up time – not just “as soon as possible”.",
          "date": "2026-10-03",
          "resolved": false,
          "criterionId": null
        },
        {
          "id": "k2",
          "kind": "question",
          "author": "Tom",
          "text": "How many orders per 10-minute slot can the kitchen handle?",
          "date": "2026-10-03",
          "resolved": true,
          "criterionId": null
        },
        {
          "id": "k3",
          "kind": "decision",
          "author": "Aylin",
          "text": "At most 12 orders per slot, then it is full.",
          "date": "2026-10-04",
          "resolved": false,
          "criterionId": "a5"
        }
      ],
      "criteria": [
        {
          "id": "a3",
          "title": "Place order",
          "format": "gwt",
          "given": "the truck is open and I have dishes in my basket",
          "when": "I tap “Pre-order now”",
          "then": "I get a confirmation with pick-up time and number",
          "text": "",
          "confirmed": false
        },
        {
          "id": "a4",
          "title": "Truck closed",
          "format": "gwt",
          "given": "the truck is closed",
          "when": "I open the app",
          "then": "pre-ordering is disabled and the next opening time is shown",
          "text": "",
          "confirmed": false
        },
        {
          "id": "a5",
          "title": "Full slot",
          "format": "check",
          "given": "",
          "when": "",
          "then": "",
          "text": "At most 12 orders per slot, then it is full.",
          "confirmed": false
        }
      ],
